{
  "name": "og-core",
  "version": "0.1.2",
  "private": true,
  "description": "Núcleo modular de servicios para la plataforma ÖG",
  "type": "module",
  "engines": { "node": ">=20.11.0" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1",
    "test:report": "node --test --test-concurrency=1 --test-reporter=spec",
    "check": "node scripts/check.js",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}